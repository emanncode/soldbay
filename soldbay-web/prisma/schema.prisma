generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
}

enum SellFrequency {
  DAILY
  WEEKLY
  OCCASIONALLY
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

model WaitlistSignup {
  id          String         @id @default(cuid())
  role        Role
  name        String
  email       String         @unique
  university  String
  level       String?
  categories  String[]
  sellsWhat   String?
  frequency   SellFrequency?
  pollAnswers String[]
  createdAt   DateTime       @default(now())
}

/** Public “Ask a question” submissions (forwarded to QUESTIONS_INBOX email). */
model SiteQuestion {
  id        String   @id @default(cuid())
  name      String
  email     String
  question  String
  createdAt DateTime @default(now())
}

model University {
  id    String   @id @default(cuid())
  name  String   @unique
  code  String   @unique
  users User[]
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  emailVerified DateTime?
  password      String? // bcrypt hash; required for credentials signup/login
  name          String
  phone         String?
  role          UserRole
  universityId  String?
  university    University?    @relation(fields: [universityId], references: [id])
  level         String?
  matricNumber  String?        @unique
  verified      Boolean        @default(false)
  deletedAt     DateTime?
  retainUntil   DateTime?
  createdAt     DateTime       @default(now())
  sellerProfile SellerProfile?
  accounts      Account[]
  sessions      Session[]
  buyerOrders   Order[]        @relation("BuyerOrders")
  buyerDisputes Dispute[]      @relation("BuyerDisputes")
  resolvedDisputes Dispute[]   @relation("ResolvedDisputes")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SellerProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  username      String    @unique
  businessName  String?
  bio           String?
  walletBalance         Decimal   @default(0)
  idImageUrl            String?
  verifiedAt            DateTime?
  verificationStatus    String    @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason       String?
  verificationAttempts  Int       @default(0)
  listings              Listing[]
  orders                Order[]   @relation("SellerOrders")
}

model Category {
  id             String    @id @default(cuid())
  name           String    @unique
  slug           String    @unique
  commissionRate Decimal
  listings       Listing[]
}

model Listing {
  id          String        @id @default(cuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id])
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title       String?
  description String?
  price       Decimal?
  images      String[]
  stock       Int           @default(1)
  status      String        @default("ACTIVE")
  draftStep   Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  orders      Order[]

  @@index([sellerId, status, updatedAt(sort: Desc)])
  @@index([sellerId])
  @@index([status, createdAt(sort: Desc)])
  @@index([categoryId, status, createdAt(sort: Desc)])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_SECURED
  PICKUP_ARRANGED
  AWAITING_CONFIRMATION
  COMPLETED
  DISPUTED
  REFUNDED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER_REFUND
  RESOLVED_SELLER_PAYOUT
  CANCELLED
}

enum DisputeResolution {
  REFUND_BUYER
  RELEASE_TO_SELLER
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  buyerId         String
  buyer           User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId        String
  seller          SellerProfile @relation("SellerOrders", fields: [sellerId], references: [id])
  listingId       String
  listing         Listing       @relation(fields: [listingId], references: [id])
  amount          Decimal
  status          OrderStatus   @default(PAYMENT_SECURED)
  pickupLocation    String?
  confirmationPin   String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  disputes          Dispute[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  @@index([buyerId, status, createdAt(sort: Desc)])
  @@index([sellerId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model Dispute {
  id              String             @id @default(cuid())
  orderId         String
  order           Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId         String
  buyer           User               @relation("BuyerDisputes", fields: [buyerId], references: [id])
  reason          String
  status          DisputeStatus      @default(UNDER_REVIEW)
  resolution      DisputeResolution?
  resolutionNotes String?
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?              @relation("ResolvedDisputes", fields: [resolvedById], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt

  @@index([orderId])
  @@index([status, createdAt(sort: Desc)])
}

