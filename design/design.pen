              "children": [
                {
                  "type": "text",
                  "id": "txed3d8",
                  "name": "Title",
                  "fill": "#2D3A1F",
                  "content": "1. Simplified Header",
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "tx00319",
                  "name": "Desc",
                  "fill": "#5C7048",
                  "content": "• Header contains ONLY: Search bar + Notification bell icon\n• REMOVED: Soldbay wordmark, message icon, cart icon\n• REMOVED: Campus display (AAUA)\n• Campus is fixed at signup, never editable, and only displays on the Profile screen (read-only)",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-ui",
                  "fontSize": 12.5,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "sc15b4de",
              "name": "Card Nav Specs",
              "width": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 16,
              "layout": "vertical",
              "gap": 10,
              "padding": 20,
              "children": [
                {
                  "type": "text",
                  "id": "tx7ebc8",
                  "name": "Title",
                  "fill": "#2D3A1F",
                  "content": "2. 4-Tab Buyer Nav Bar",
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "txa4f24",
                  "name": "Desc",
                  "fill": "#5C7048",
                  "content": "• 4 tabs only: Browse · Search · Orders · Profile\n• REMOVED: '+' / Sell FAB (posting is seller-only, never in buyer browse)\n• REMOVED: Wallet (buyers have no wallet destination)\n• Active tab: Browse ($soldbay-primary bold, Phosphor house icon)",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-ui",
                  "fontSize": 12.5,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "sc2de98a",
              "name": "Card Grid Specs",
              "width": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 16,
              "layout": "vertical",
              "gap": 10,
              "padding": 20,
              "children": [
                {
                  "type": "text",
                  "id": "txef93e",
                  "name": "Title",
                  "fill": "#2D3A1F",
                  "content": "3. 2-Column Grid (Section 8)",
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "tx7c5a9",
                  "name": "Desc",
                  "fill": "#5C7048",
                  "content": "• Gutter: space-4 (16px), 16px screen padding\n• Column width: 171px on 390px viewport (identical across Feed & Search)\n• Verified Badge Row: [✓ Shield Icon] [Business Name] (Sora 12px Caption)\n• Single-line truncation: Ellipsis on overflow, never wraps to 2nd line\n• Reuses locked Product Cards directly (Default, Discounted, Sold, No Photo)",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-ui",
                  "fontSize": 12.5,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "sc3bd007",
              "name": "Card States Specs",
              "width": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 16,
              "layout": "vertical",
              "gap": 10,
              "padding": 20,
              "children": [
                {
                  "type": "text",
                  "id": "tx42bf0",
                  "name": "Title",
                  "fill": "#2D3A1F",
                  "content": "4. Empty, Skeleton & PTR",
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "txc7fd0",
                  "name": "Desc",
                  "fill": "#5C7048",
                  "content": "• Empty (Buyer-Only): NO 'Post a listing' button (buyers cannot sell)\n• Filtered Empty: Primary button 'Clear filters' (promoted from secondary link)\n• Zero-Listings Campus Feed: 'No listings yet' + 'Check back soon for new listings' (no actionable button)\n• Skeleton: Surface-colored blocks in grid shape\n• PTR: Primary-tinted spinner arc (#5A743E / #8BA670)",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-ui",
                  "fontSize": 12.5,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
