      "children": [
        {
          "type": "text",
          "id": "fEUN0",
          "name": "Stack Note",
          "fill": "#8e8e93",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Mobile equivalent of soldbay-web's design system. Same tokens, glass approach adapted via expo-blur/GlassPanel. No shadcn (React Native has no DOM). NativeWind classes. 8pt grid enforced throughout.",
          "lineHeight": 1.4,
          "fontFamily": "Inter",
          "fontSize": 11,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "N9OlKN",
          "name": "Main Title",
          "fill": "#ffffff",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Soldbay Mobile — Design System Reference",
          "fontFamily": "Bricolage Grotesque",
          "fontSize": 22,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "MHhTF",
          "name": "Subtitle",
          "fill": "#8e8e93",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Audit tool — match every token against soldbay-design-system.md. Do not invent new values.",
          "lineHeight": 1.4,
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "rectangle",
